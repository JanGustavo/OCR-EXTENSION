{
  "manifest_version": 3,
  "name": "OCR Passagens — AutoFill",
  "version": "1.0.0",
  "description": "Extrai dados pessoais via OCR e injeta automaticamente em formulários de companhias aéreas brasileiras.",

  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],

  "host_permissions": [
    "https://*.latam.com/*",
    "https://*.latamairlines.com/*",
    "https://*.gol.com.br/*",
    "https://*.voegol.com.br/*",
    "https://*.smiles.com.br/*",
    "https://*.azul.com.br/*",
    "https://*.voeazul.com.br/*",
    "file:///*"
  ],

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "OCR Passagens",
    "default_icon": {
      "16": "assets/tesseract/icons/icon16.png",
      "48": "assets/tesseract/icons/icon48.png",
      "128": "assets/tesseract/icons/icon128.png"
    }
  },

  "icons": {
    "16": "assets/tesseract/icons/icon16.png",
    "48": "assets/tesseract/icons/icon48.png",
    "128": "assets/tesseract/icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": [
        "https://*.latam.com/*",
        "https://*.latamairlines.com/*",
        "https://*.gol.com.br/*",
        "https://*.voegol.com.br/*",
        "https://*.smiles.com.br/*",
        "https://*.azul.com.br/*",
        "https://*.voeazul.com.br/*",
        "file:///*"
      ],
      "js": [
        "content/providers/gol-smiles.js",
        "content/providers/latam.js",
        "content/providers/azul.js",
        "content/injector.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "assets/tesseract/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
